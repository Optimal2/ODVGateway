<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ODVGateway</RootNamespace>
    <AssemblyName>ODVGateway</AssemblyName>
    <Authors>Optimal2</Authors>
    <Description>Standalone handoff gateway for OpenDocViewer sessions.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Optimal2/ODVGateway</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Optimal2/ODVGateway</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.1" />
    <!-- Signature validation: PDF object graph reader (Apache-2.0, pure managed, no native
         dependencies) plus the CMS/PKCS#7 and RFC 3161 types, which are not part of the
         ASP.NET Core shared framework's compile-time reference set. -->
    <PackageReference Include="pdfpig" Version="0.1.16" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lets tests/ODVGateway.Tests probe the top-level Program via WebApplicationFactory. -->
    <InternalsVisibleTo Include="ODVGateway.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Packaging/ holds the OMP artifact configuration file shipped inside the
         artifact package (configuration/appsettings.json), not in the payload. -->
    <Content Remove="Packaging/**" />
  </ItemGroup>
</Project>
