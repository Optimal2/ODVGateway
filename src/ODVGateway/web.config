<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <httpProtocol>
        <customHeaders>
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <!--
            Referrer-Policy is owned by the application middleware alone. IIS appends
            customHeaders after the application's own headers, and browsers apply the
            LAST Referrer-Policy value, so an IIS copy of "no-referrer" silently undid the
            "strict-origin-when-cross-origin" the gateway sets on the ?sessiondata= ->
            ?bundleUrl= redirect (the follow-up request then lost its Referer and the
            handoff guard rejected the gateway's own redirect with 403). Do not add it here.
          -->
          <!--
            Content-Security-Policy: the application middleware already sets a
            complete policy on every response and should stay the header's only
            owner. Do NOT add a second CSP here: with two CSP headers the browser
            enforces the intersection, so a stricter IIS copy silently re-breaks
            the viewer's PDF printing (measured on SU Test 2026-09-15). If a
            site-specific policy is truly required, set it through
            ODVGateway:contentSecurityPolicy instead, and keep
            frame-src 'self' blob: and connect-src 'self' blob: (see README).
            Strict-Transport-Security remains deployment-specific: add HSTS in
            the hosting environment once the final HTTPS topology is known.
          -->
        </customHeaders>
      </httpProtocol>
      <!--
        Keep ASP.NET Core stdout logging disabled in the checked-in template.
        Enable it temporarily in a deployment-specific web.config only while
        troubleshooting startup failures; otherwise stdout logs can grow quickly
        and may capture sensitive operational details.
      -->
      <aspNetCore processPath="dotnet" arguments=".\ODVGateway.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxUrl="65536" maxQueryString="65536" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
