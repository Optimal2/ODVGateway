<Project>
  <PropertyGroup>
    <!-- Build against the selected SDK's compiler, without package downloads. -->
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <!-- A consumer and its referenced OMP checkout both carry this project.
         Distinguish their physical copies within the caller's isolated root. -->
    <_OmpRazorBuildIdentity>$([MSBuild]::StableStringHash('$(MSBuildThisFileDirectory)'))</_OmpRazorBuildIdentity>
    <BaseIntermediateOutputPath Condition="'$(OmpIsolatedBuildRoot)' != ''">$(OmpIsolatedBuildRoot)/obj/OmpDeterministicRazor/$(_OmpRazorBuildIdentity)/</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(OmpIsolatedBuildRoot)' != ''">$(OmpIsolatedBuildRoot)/bin/OmpDeterministicRazor/$(_OmpRazorBuildIdentity)/</BaseOutputPath>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <PathMap>$(MSBuildThisFileDirectory)=/_/omp-build/</PathMap>
    <PathMap Condition="'$(OmpIsolatedBuildRoot)' != ''">$([MSBuild]::EnsureTrailingSlash('$(BaseIntermediateOutputPath)'))=/_/omp-build/obj/,$([MSBuild]::EnsureTrailingSlash('$(BaseOutputPath)'))=/_/omp-build/bin/,$(PathMap)</PathMap>
  </PropertyGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <!-- Build against the selected SDK's compiler, without package downloads.
         RoslynCoreAssembliesPath is the SDK's own Roslyn\bincore directory (the
         compiler this generator must match) and is set by Microsoft.NET.Sdk on
         every build host. $(MSBuildToolsPath) cannot be used: under Visual
         Studio's MSBuild.exe it is the VS bin directory and holds neither
         Roslyn\bincore nor Sdks\Microsoft.NET.Sdk.Razor. -->
    <_OmpRoslynAssembliesPath>$(RoslynCoreAssembliesPath)</_OmpRoslynAssembliesPath>
    <_OmpRoslynAssembliesPath Condition="'$(_OmpRoslynAssembliesPath)' == ''">$(MSBuildToolsPath)\Roslyn\bincore</_OmpRoslynAssembliesPath>
    <_OmpRazorSourceGenerators>$([System.IO.Path]::GetFullPath('$(_OmpRoslynAssembliesPath)\..\..\Sdks\Microsoft.NET.Sdk.Razor\source-generators'))</_OmpRazorSourceGenerators>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DeterministicRazorGenerator.cs" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(_OmpRoslynAssembliesPath)\Microsoft.CodeAnalysis.dll" Private="false" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(_OmpRoslynAssembliesPath)\Microsoft.CodeAnalysis.CSharp.dll" Private="false" />
    <Reference Include="Microsoft.CodeAnalysis.Razor.Compiler" HintPath="$(_OmpRazorSourceGenerators)\Microsoft.CodeAnalysis.Razor.Compiler.dll" Private="true" />
    <Reference Include="Microsoft.AspNetCore.Razor.Utilities.Shared" HintPath="$(_OmpRazorSourceGenerators)\Microsoft.AspNetCore.Razor.Utilities.Shared.dll" Private="true" />
  </ItemGroup>
</Project>
