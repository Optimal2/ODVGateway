<Project>

  <!--
    Deterministic publish endpoints manifest for static web assets.

    The SDK writes a "Last-Modified" response header for every static web asset
    endpoint into <app>.staticwebassets.endpoints.json, and takes its value from
    the file system timestamp of the asset (and of the .gz/.br files the build
    compresses). A fresh checkout or worktree gives every file a new timestamp,
    so the same source at the same component version published a different
    endpoints manifest - and therefore a different artifact SHA-256. Measured
    2026-09-28: an import rejected content-webapp 0.3.316, omp-auth 0.3.321 and
    iframe-webapp 0.3.309 with "The artifact content has changed under the same
    version"; in each the ONLY differing payload file was the endpoints manifest,
    and it was byte-identical once the Last-Modified values were ignored.

    The fix pins every Last-Modified value in the PUBLISH manifest to a fixed
    date. Caching stays correct: every endpoint also carries a strong ETag that
    is the SHA-256 of the served content, and ASP.NET Core static assets take the
    If-None-Match result over If-Modified-Since, so changed content is still
    served in full. The build (development) manifest is left untouched.

    Imported by this repository's Directory.Build.targets. The manifest is
    generated by the consuming web project, not by Web.Shared, so every module
    repository with a Microsoft.NET.Sdk.Web project carries a verbatim copy at
    the same path (build/OpenModulePlatform.DeterministicStaticWebAssets.targets)
    and imports it from its own Directory.Build.targets.
    scripts/omp/validate-shared-scripts.ps1 (Check 15 in the consumer
    validators) fails when that copy drifts from this file or is not imported.
    When this file changes, copy it to those repositories in the same change.
  -->
  <PropertyGroup>
    <OmpStaticWebAssetsFixedLastModified Condition="'$(OmpStaticWebAssetsFixedLastModified)' == ''">Sat, 01 Jan 2000 00:00:00 GMT</OmpStaticWebAssetsFixedLastModified>
  </PropertyGroup>

  <!--
    The rewrite runs in a small inline task rather than through ReadAllText and
    WriteLinesToFile: WriteLinesToFile ends every line with a newline, so it
    appended a trailing line break the SDK manifest does not have, and routing
    the JSON through an MSBuild property exposes it to MSBuild escaping. The task
    round-trips the bytes as UTF-8, changes nothing but the Last-Modified
    values, and leaves the file untouched when there is nothing to change.
  -->
  <UsingTask TaskName="OmpPinStaticWebAssetsLastModified"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ManifestPath ParameterType="System.String" Required="true" />
      <FixedLastModified ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
// Decoded without BOM detection, so a BOM - if the SDK ever writes one -
// survives the round trip as U+FEFF instead of being dropped.
var encoding = new System.Text.UTF8Encoding(false);
var original = encoding.GetString(System.IO.File.ReadAllBytes(ManifestPath));
var pinned = System.Text.RegularExpressions.Regex.Replace(
    original,
    @"(""Name""\s*:\s*""Last-Modified""\s*,\s*""Value""\s*:\s*"")[^""]*("")",
    match => match.Groups[1].Value + FixedLastModified + match.Groups[2].Value);
if (!string.Equals(original, pinned, System.StringComparison.Ordinal))
{
    System.IO.File.WriteAllBytes(ManifestPath, encoding.GetBytes(pinned));
}
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="OmpNormalizeStaticWebAssetsPublishEndpointsLastModified"
          AfterTargets="GenerateStaticWebAssetsPublishManifest"
          Condition="'$(OmpDeterministicStaticWebAssets)' != 'false' And '$(StaticWebAssetEndpointsPublishManifestPath)' != '' And Exists('$(StaticWebAssetEndpointsPublishManifestPath)')">
    <OmpPinStaticWebAssetsLastModified ManifestPath="$(StaticWebAssetEndpointsPublishManifestPath)"
                                       FixedLastModified="$(OmpStaticWebAssetsFixedLastModified)" />
  </Target>

</Project>
